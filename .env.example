# ─────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and paste your key:
#
#   cp .env.example .env.local
#
# Get a free key at https://muapi.ai → sign up → API Keys.
# Leave empty to run in demo mode (placeholder assets, no key needed).
# ─────────────────────────────────────────────────────────────
MUAPI_API_KEY=

# Optional: override the Muapi base URL (default: https://api.muapi.ai/api/v1)
# MUAPI_BASE_URL=

# Optional legacy alias: if MUAPI_API_KEY is unset, the app falls back to
# GENAI_API_KEY. Prefer MUAPI_API_KEY above; this exists only for older setups.
# GENAI_API_KEY=
